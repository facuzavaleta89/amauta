# ============================================================
# Amauta — Variables de Entorno Requeridas
# ============================================================
# Copiá este archivo como .env.local y completá los valores.
# NUNCA commiteés .env.local al repositorio.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# URL pública del proyecto Supabase (segura para exponer al cliente)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon/public de Supabase (segura para exponer al cliente)
# Solo tiene permisos que RLS permite para usuarios anónimos/autenticados
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave de Service Role de Supabase (⚠️ SECRETA — bypasea RLS completamente)
# Usar SOLO en código server-side (API Routes, Server Actions)
# NUNCA exponer al cliente ni loguear
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── URL base de la app ────────────────────────────────────────
# URL pública de la app, usada como base de los QR de verificación de documentos
# (pedidos/certificados) que apuntan a /verificar/[codigo].
# ⚠ IMPORTA especialmente ahora que los PDF se CONGELAN al emitir: el QR queda
# grabado en el archivo, así que la base debe ser un valor de confianza y no
# derivarse del header `Host` del request (evita un QR envenenado permanente).
# Producción (Vercel): https://amauta-salud.vercel.app · Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cron Jobs ─────────────────────────────────────────────────
# Secret para proteger el endpoint /api/cron/recordatorios
# Generarlo con: openssl rand -base64 32
# Configurarlo también en Vercel Cron / tu plataforma de scheduling
# ⚠️ OBLIGATORIO: el endpoint rechaza requests sin este valor
CRON_SECRET=genera-un-secreto-largo-y-aleatorio-aqui

# ── Email (Resend) ────────────────────────────────────────────
# API key de Resend. REQUERIDA para que funcione el envío de difusión por email:
# sin ella el envío falla con un mensaje claro (uno por destinatario).
# El resto de la app funciona —y buildea— sin ella: el cliente de Resend se
# instancia de forma perezosa, recién al enviar (ver src/lib/email/resend.ts).
RESEND_API_KEY=re_...

# Dirección remitente de los emails de difusión (opcional).
# Si no se define, cae a onboarding@resend.dev, el SANDBOX de Resend.
# ⚠ En sandbox (sin dominio verificado) Resend SOLO entrega a la casilla dueña de
# la cuenta: sirve para probar, pero no llega a los pacientes.
# Para el envío real hay que VERIFICAR UN DOMINIO en Resend (registros DNS) y
# setear esta variable con una dirección de ese dominio.
# RESEND_FROM=comunicados@tu-dominio.com

# ── WhatsApp (si se implementa integración) ───────────────────
# WHATSAPP_API_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
